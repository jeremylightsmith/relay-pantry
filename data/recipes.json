    {
      "id": "black-bean-tacos",
      "title": "Black bean tacos",
      "photoUrl": "https://images.unsplash.com/photo-1565299585323-38d6b0865b47?w=800",
      "totalMinutes": 25,
      "tags": ["Vegetarian", "Weeknight"],
      "addedBy": "Maya",
      "addedAt": "2026-10-18T18:30:00Z",
      "servings": 4,
      "ingredients": [
        { "amount": 2, "unit": "cans", "item": "black beans", "note": "drained and rinsed" },
        { "amount": 1, "unit": null, "item": "red onion", "note": "finely diced" },
        { "amount": 2, "unit": "cloves", "item": "garlic", "note": "minced" },
        { "amount": 1, "unit": "tsp", "item": "ground cumin", "note": null },
        { "amount": 0.5, "unit": "tsp", "item": "smoked paprika", "note": null },
        { "amount": 8, "unit": null, "item": "corn tortillas", "note": null },
        { "amount": 1, "unit": null, "item": "avocado", "note": "sliced" },
        { "amount": 0.5, "unit": "cup", "item": "crumbled feta", "note": null },
        { "amount": 1, "unit": null, "item": "lime", "note": "cut into wedges" },
        { "text": "a handful of fresh coriander" },
        { "text": "salt to taste" }
      ],
      "steps": [
        "Warm a splash of oil in a pan over medium heat and soften the onion for 5 minutes.",
        "Add the garlic, cumin and paprika and stir for 1 minute until fragrant.",
        "Tip in the beans with a splash of water, then mash about half of them with a fork. Simmer for 5 minutes and season with salt.",
        "Warm the tortillas in a dry pan, about 30 seconds a side.",
        "Fill each tortilla with beans, avocado, feta and coriander, and serve with lime wedges."
      ]
    },
    {
      "id": "lemon-garlic-roast-chicken",
      "title": "Lemon garlic roast chicken",
      "photoUrl": "https://images.unsplash.com/photo-1598103442097-8b74394b95c6?w=800",
      "totalMinutes": 90,
      "tags": ["Sunday", "Family"],
      "addedBy": "Sam",
      "addedAt": "2026-10-12T16:05:00Z",
      "servings": 6,
      "ingredients": [
        { "amount": 1, "unit": null, "item": "whole chicken", "note": "about 1.8 kg" },
        { "amount": 2, "unit": null, "item": "lemons", "note": "halved" },
        { "amount": 1, "unit": null, "item": "garlic bulb", "note": "halved across the middle" },
        { "amount": 3, "unit": "tbsp", "item": "olive oil", "note": null },
        { "amount": 1, "unit": "kg", "item": "small potatoes", "note": "halved" },
        { "amount": 4, "unit": "sprigs", "item": "thyme", "note": null },
        { "text": "salt and pepper to taste" }
      ],
      "steps": [
        "Heat the oven to 200°C. Take the chicken out of the fridge 30 minutes before roasting.",
        "Toss the potatoes with 2 tbsp of the oil and some salt in a large roasting tin.",
        "Stuff the chicken with the lemon halves, garlic and thyme. Rub with the rest of the oil and season well.",
        "Sit the chicken on the potatoes and roast for 1 hour 15 minutes, until the juices run clear.",
        "Rest the chicken for 10 minutes before carving. Squeeze the roasted lemon over the potatoes."
      ]
    },
    {
      "id": "miso-glazed-salmon",
      "title": "Miso glazed salmon with sesame greens",
      "photoUrl": "https://images.unsplash.com/photo-1467003909585-2f8a72700288?w=800",
      "totalMinutes": 30,
      "tags": ["Fish", "Weeknight"],
      "addedBy": "Jo",
      "addedAt": "2026-10-15T19:12:00Z",
      "servings": 2,
      "ingredients": [
        { "amount": 2, "unit": null, "item": "salmon fillets", "note": "skin on" },
        { "amount": 2, "unit": "tbsp", "item": "white miso", "note": null },
        { "amount": 1, "unit": "tbsp", "item": "honey", "note": null },
        { "amount": 1, "unit": "tbsp", "item": "soy sauce", "note": null },
        { "amount": 1, "unit": "tsp", "item": "sesame oil", "note": null },
        { "amount": 200, "unit": "g", "item": "greens", "note": "pak choi or tenderstem broccoli" },
        { "amount": 1, "unit": "tbsp", "item": "sesame seeds", "note": "toasted" },
        { "text": "steamed rice, to serve" }
      ],
      "steps": [
        "Heat the grill to high and line a tray with foil.",
        "Whisk the miso, honey and soy sauce together and spread over the salmon.",
        "Grill the salmon for 8 to 10 minutes, until the glaze is caramelised and the fish flakes.",
        "Meanwhile, stir-fry the greens in the sesame oil for 3 minutes.",
        "Serve the salmon on rice with the greens and a scatter of sesame seeds."
      ]
    },
